// =================================================================================================
// SITE-67 ART KIT — Ozea (PARTIAL), and the asset-swap acceptance fixture.
//
// Two jobs, deliberately one file:
//
//  1. It is the swap PROOF. `site::kit::tests::the_site_kit_is_swappable_by_authoring_one_file`
//     loads it and asserts the Site's look — and its SCALES — changed with zero code edits. Before
//     2026-08-01 the Site's kit was a `match` in Rust and this was impossible to state.
//
//  2. It is the START of the dressed kit, and it is honest about how far that has got: it names ONLY
//     meshes actually promoted into `assets/`. The full library converts fine (418/418 via
//     `scripts/fbx_to_glb.py`) but conversion writes to STAGING — `docs/artist_guide.md` §2 keeps
//     `assets/` to what the game loads, named for its use, and a human promotes. A kit naming
//     unpromoted meshes validates cleanly and renders nothing, which is exactly the trap
//     `pieces::every_piece_maps_to_a_glb_that_exists_on_disk` now covers for every shipped kit.
//
// HEIGHT is the mesh's authored height in metres; the scale applied is `target / authored`. Ozea is
// a MIXED module (this floor is 0.05 m, the doorframe 1.98 m) which is the whole reason the height
// lives in the kit rather than in a `KIT_MODULE_HEIGHT` constant.
//
// ⚠️ Do NOT map containment cells from `Cellule` when promoting more:
// `docs/2026-07-26-site-hub-and-operative-knowledge.md` §7 measured it at 0.30 m — a French *battery*
// cell, not a room.
// =================================================================================================
(
    // ── Ozea, promoted ──
    floor:             (glb: "ozea/floor_grate.glb",             height: 0.05),
    wall_doorway_wide: (glb: "site/ozea/doorframe_double.glb",   height: 1.98),
    floor_button:      (glb: "ozea/floor_light.glb",             height: 0.06),

    // ── Still greybox, awaiting promotion from staging ──
    wall:              (glb: "kenney_prototype-kit/Models/GLB format/wall.glb", height: 1.0),
    wall_corner:       (glb: "kenney_prototype-kit/Models/GLB format/wall-corner.glb", height: 1.0),
    wall_doorway:      (glb: "kenney_prototype-kit/Models/GLB format/wall-doorway.glb", height: 1.0),
    wall_window:       (glb: "kenney_prototype-kit/Models/GLB format/wall-window-large.glb", height: 1.0),
    wall_low:          (glb: "kenney_prototype-kit/Models/GLB format/wall-low.glb", height: 0.5),
    column:            (glb: "kenney_prototype-kit/Models/GLB format/column.glb", height: 1.0),
    crate_:            (glb: "kenney_prototype-kit/Models/GLB format/crate-color.glb", height: 1.0),
    pipe:              (glb: "kenney_prototype-kit/Models/GLB format/pipe.glb", height: 1.0),
    pipe_corner:       (glb: "kenney_prototype-kit/Models/GLB format/pipe-corner.glb", height: 1.0),
    area_decal:        (glb: "kenney_prototype-kit/Models/GLB format/indicator-square-a.glb", height: 1.0),
    arrow_decal:       (glb: "kenney_prototype-kit/Models/GLB format/indicator-special-arrow.glb", height: 1.0),
    specimen_standin:  (glb: "kenney_prototype-kit/Models/GLB format/shape-cylinder-detailed.glb", height: 1.0),
)

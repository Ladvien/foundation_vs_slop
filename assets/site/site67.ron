        // way in, which was the single worst case in the Site — 1.72 m² of overlap on one cell alone.
        ( piece: ControlDesk,   pos: (59.5, 42.9), yaw:  90.0 ),
        ( piece: ServerRack,    pos: (57.6, 47.8), yaw:   0.0 ),
        ( piece: Locker,        pos: (61.4, 47.6), yaw: 270.0 ),

        // ═══ DRESSING: the lived-in layer (2026-08-02) ═══════════════════════════════════════════
        //
        // Split by MEANING: Ozea is what the Foundation ISSUED, `assets/low_poly_furniture/` is what
        // somebody BROUGHT. Ozea has no mugs, books, food or bags anywhere in its 418 meshes — it is a
        // facility kit — so the human half has to come from elsewhere, and the seam is deliberate.
        //
        // The fiction this dresses is the RECOMMISSIONING (docs/lore/2026-08-02-site-67-recommissioned.md):
        // a site reopened around an aperture nobody planned for, staffed by people who have been here
        // months. So the empty wings are not bare — they are still half unpacked.
        //
        // A prop with `rests_on` in the kit takes its HEIGHT FROM ITS HOST, derived at build time from
        // the nearest `surface: true` piece. Author only the XZ position; `check_prop_placements`
        // refuses a resting prop with no surface in reach rather than burying it in the deck.

        // ── CONTAINMENT  x[14,30) z[2,12) — was ZERO props ──
        //
        // Sixteen by ten cells, and until now the only things in it were the six cell booths. The
        // booths occupy z[3,5]; the spine threshold is z[11,12]; so the working strip is z 7..10.
        // Read as: the wing is still half a store room, which is exactly what a reopened site looks
        // like before it has filled its cells.
        // RELOCATED (containment wing became twelve cell rooms): ( piece: Pallet,        pos: (16.6,  8.2), yaw:   0.0 ),
        // RELOCATED (containment wing became twelve cell rooms): ( piece: StorageCrate,  pos: (16.6,  9.6), yaw:   0.0 ),
        // RELOCATED (containment wing became twelve cell rooms): ( piece: StorageBox,    pos: (18.2,  8.3), yaw:  90.0 ),
        // RELOCATED (containment wing became twelve cell rooms): ( piece: StepLadder,    pos: (20.4,  8.6), yaw: 180.0 ),
        // RELOCATED (containment wing became twelve cell rooms): ( piece: UtilityCart,   pos: (23.2,  8.6), yaw:  90.0 ),
        // RELOCATED (containment wing became twelve cell rooms): ( piece: TrashBin,      pos: (26.4,  8.8), yaw:   0.0 ),

        // ── RESEARCH  x[10,22) z[14,24) — was TWO props, one of them a decal ──
        //
        // The 12x10 wing BACKLOG.md:839 calls "an empty floor". The slab and its spot stay the subject;
        // these say the room is worked in rather than furnished.
        ( piece: UtilityCart,   pos: (25.4, 27.4), yaw:  90.0 ),
        ( piece: StorageBox,    pos: (25.2, 32.8), yaw:   0.0 ),
        ( piece: TrashBin,      pos: (33.4, 32.9), yaw:   0.0 ),

        // ── RECORDS  x[0,8) z[14,22) — 2900 K tungsten, "paper, dust, and a desk lamp" ──
        ( piece: TrashBin,      pos: ( 12.6, 31.4), yaw:   0.0 ),
        ( piece: StorageBox,    pos: ( 12.4, 27.2), yaw: 270.0 ),

        // ── BRIEFING  x[24,34) z[22,30) — was ONE prop, and all five operatives stand here ──
        //
        // A mess table earns its place twice: the room needed something to gather round, and it is the
        // only `surface: true` piece in the room — so it is what the folder and the mug rest on.
        ( piece: MessTable,     pos: (59.2, 27.4), yaw:   0.0 ),
        ( piece: DataFolder,    pos: (59.1, 27.3), yaw:  20.0 ),
        ( piece: Mug,           pos: (59.4, 27.6), yaw:   0.0 ),
        ( piece: TrashBin,      pos: (65.6, 26.0), yaw:   0.0 ),

        // ── ASYNC APERTURE HALL  x[0,12) z[2,12) — four floor markings and nothing standing ──
        //
        // Kept sparse on purpose: the hall's job is to be the dark room the door glows into, and the
        // threshold pads are diegetic UI. Two crates against the west wall, well clear of the door.
        ( piece: StorageCrate,  pos: ( 7.0,  9.6), yaw:  90.0 ),
        ( piece: Pallet,        pos: ( 7.2,  7.6), yaw:  90.0 ),

        // ── GALLEY — what somebody brought ──
        ( piece: Mug,           pos: ( 25.3, 43.4), yaw:   0.0 ),
        ( piece: Mug,           pos: ( 26.6, 48.4), yaw:   0.0 ),

        // ── WAR ROOM — the map table is the centrepiece, so it is what carries the paper ──
        ( piece: DataFolder,    pos: (59.2, 45.2), yaw: 340.0 ),
        ( piece: Books,         pos: (59.9, 44.7), yaw:  15.0 ),

        // ── MONITORING — a mug on a console at 06:00 ──
        ( piece: Mug,           pos: (68.0,  6.3), yaw:   0.0 ),

        // ── MONITORING  x[30,34) z[2,12) ──
        //
        // The room is pointed at the thing it watches; that is the whole reason it is here rather than
        // in the south wing with the domestic rooms.
        //
        // ⚠️ CONSOLES MOVED TO THE EAST WALL, 2026-08-02. They were authored "down the WEST wall, which
        // is the wall it shares with the containment wing" — and there is no such wall. Measured: every
        // cell of the x=30 boundary is walkable on both sides, so monitoring is open to the containment
        // wing along its entire length and the console run was standing across the only way in. The
        // room's one real wall is x=34, so the consoles line that instead and the operators now sit
        // with their backs to the east wall looking west at the cells — which is the same sightline the
        // original note wanted, arrived at from the other side.
        ( piece: SurveillanceConsole, pos: (68.1,  4.0), yaw: 270.0 ),
        ( piece: SurveillanceConsole, pos: (68.1,  6.0), yaw: 270.0 ),
        ( piece: SurveillanceConsole, pos: (68.1,  8.0), yaw: 270.0 ),
        // Pulled up to the consoles from the west, so the seat-faces-surface rule holds with the run
        // on the other side.
        ( piece: CommandChair,        pos: (66.9,  4.0), yaw:   0.0 ),
        ( piece: CommandChair,        pos: (66.9,  6.0), yaw:   0.0 ),
        ( piece: ServerRack,          pos: (67.6, 10.4), yaw: 270.0 ),
        ( piece: ServerRack,          pos: (67.6,  2.6), yaw: 270.0 ),
    ],

    // Containment cells (FVS-D-4). Indices must be dense from 0 — specimens fill them in
    // `Specimen::captured_tick` order, so "cell 0 holds the first thing you ever caught" is stable.
    // Six is the first pass; overflow is a `warn!` and no body, never a silently dropped record.
    cells: [
        ( index:  0, pos: (25.0,  5.0), yaw: 180.0 ),
        ( index:  1, pos: (32.0,  5.0), yaw: 180.0 ),
        ( index:  2, pos: (39.0,  5.0), yaw: 180.0 ),
        ( index:  3, pos: (46.0,  5.0), yaw: 180.0 ),
        ( index:  4, pos: (53.0,  5.0), yaw: 180.0 ),
        ( index:  5, pos: (60.0,  5.0), yaw: 180.0 ),
        ( index:  6, pos: (25.0, 16.0), yaw:   0.0 ),
        ( index:  7, pos: (32.0, 16.0), yaw:   0.0 ),
        ( index:  8, pos: (39.0, 16.0), yaw:   0.0 ),
        ( index:  9, pos: (46.0, 16.0), yaw:   0.0 ),
        ( index: 10, pos: (53.0, 16.0), yaw:   0.0 ),
        ( index: 11, pos: (60.0, 16.0), yaw:   0.0 ),
    ],

    // The ASYNC door. Walking an avatar into the trigger calls `NextState::set(RunState::Active)` —
    // FVS-A-5 already implements that transition end to end, so the door needs NO new state machinery.
    //
    // `pos` and `frame_pos` are two different things and were conflated until 2026-08-01. `pos` is the
    // TRIGGER centre and carries a real invariant — `validate` flood-fills to it, so it must sit on
    // reachable floor, and the z=1 perimeter row is not floor and cannot host it. `frame_pos` is where
    // the FRAME stands: in the gap, on the wall line (cell centres there are z=1.5), centred on the two
    // held-clear cells at x=7.0. Placing the frame at `pos` stood it a metre out on the hall floor.
    //
    // `yaw: 90.0` because the z=1 run separates along Z — the same convention the walls header states,
    // and `doorframe_double.glb` is thin along X exactly like `SM_Wall_1x2`. It was authored 0.0, which
    // turned the frame across the run. The trigger extents corroborate the fix rather than the bug:
    // hx=1.6 is ACROSS the opening and hz=0.7 is THROUGH it, which is only true of an X-running door.
    door: (
        pos:                  (13.0, 2.5),
        frame_pos:            (13.0, 1.5),
        yaw:                  90.0,
        trigger_half_extents: (1.6, 1.2, 0.7),
    ),

    // Operatives idle in the briefing room — the far end, so leaving means walking the length of the
    // Site past the cells.
    spawns: [
        (60.5, 29.5),
        (62.0, 29.5),
        (63.5, 29.5),
        (61.0, 30.5),
        (62.8, 30.5),
    ],
)

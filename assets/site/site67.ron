        ( piece: WallLow,    pos: (44.5, 29.5), yaw:  90.0 ),
        ( piece: WallLow,    pos: (45.5, 29.5), yaw:  90.0 ),
        // Wing colour-codes — THIS is what makes the hub learnable without signage (design doc §2.1).
        ( piece: AreaDecal,  pos: ( 9.5, 28.5), yaw:   0.0 ),   // records
        ( piece: AreaDecal,  pos: (28.5, 29.5), yaw:   0.0 ),   // research
        ( piece: AreaDecal,  pos: (43.5, 27.5), yaw:   0.0 ),   // requisition
        ( piece: AreaDecal,  pos: (61.5, 28.5), yaw:   0.0 ),   // briefing
        ( piece: AreaDecal,  pos: ( 8.5, 44.5), yaw:   0.0 ),   // quarters
        ( piece: AreaDecal,  pos: ( 25.5, 44.5), yaw:   0.0 ),   // galley
        ( piece: AreaDecal,  pos: (42.5, 44.5), yaw:   0.0 ),   // activities
        ( piece: AreaDecal,  pos: (59.5, 44.5), yaw:   0.0 ),   // war room
        ( piece: AreaDecal,  pos: (66.5,  7.5), yaw:   0.0 ),   // monitoring

        // ── QUARTERS  x[0,5) z[26,34) ──
        //
        // Four bunks head-to-wall down the west side with a locker and a bedside table each, which is
        // what makes the room read as somewhere FIVE people live rather than a bedroom. Bunks run along
        // Z (yaw 0) so their long axis is the room's long axis; the aisle is the east half.
        //
        // ⚠️ EVERYTHING HERE MOVED SOUTH ON 2026-08-02, and the reason applies to all four south rooms.
        // These were authored against a "north wall" that does not exist: the room's entire z=26 edge is
        // its way in from the south spine (openings in Site-67 are the ABSENCE of wall, so a room can be
        // open along a whole side). Furniture on that edge was standing in the doorway.
        // `check_prop_placements` now derives every threshold and refuses this — see THRESHOLD_CLEAR.
        ( piece: Bunk,          pos: ( 6.8, 43.1), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 7.8, 42.4), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 10.4, 42.5), yaw: 270.0 ),
        ( piece: Bunk,          pos: ( 6.8, 45.5), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 7.8, 44.7), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 10.4, 43.3), yaw: 270.0 ),
        ( piece: Bunk,          pos: ( 6.8, 47.8), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 7.8, 47.0), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 10.4, 44.1), yaw: 270.0 ),
        ( piece: Locker,        pos: ( 10.4, 44.9), yaw: 270.0 ),

        // ── GALLEY  x[6,11) z[26,34) ──
        //
        // Work surface and appliances along the SOUTH wall — z=34, which is a real wall — with eating in
        // the middle and the way in from the spine left clear. The counter run was authored along z=26
        // against a "north wall" that is actually the doorway; see the QUARTERS note.
        //
        // The coffee machine sits ON the counter run rather than on the floor: `y_offset` is a kit fact,
        // so it is placed at counter height here by standing it on the counter's own 0.75 m top.
        ( piece: GalleyCounter, pos: ( 24.0, 48.6), yaw:  90.0 ),
        ( piece: GalleyCounter, pos: ( 25.4, 48.6), yaw:  90.0 ),
        ( piece: GalleyCounter, pos: ( 26.8, 48.6), yaw:  90.0 ),
        ( piece: CoffeeMachine, pos: ( 24.2, 47.8), yaw:   0.0 ),
        ( piece: WaterDispenser,pos: (27.5, 47.8), yaw:   0.0 ),
        ( piece: MessTable,     pos: ( 25.5, 43.6), yaw:   0.0 ),
        ( piece: Stool,         pos: ( 24.6, 43.6), yaw:  90.0 ),
        ( piece: Stool,         pos: ( 26.4, 43.6), yaw: 270.0 ),
        ( piece: MessTable,     pos: ( 25.5, 45.9), yaw:   0.0 ),
        ( piece: Stool,         pos: ( 24.6, 45.9), yaw:  90.0 ),
        ( piece: Stool,         pos: ( 26.4, 45.9), yaw: 270.0 ),

        // ── ACTIVITIES  x[12,17) z[26,34) ──
        //
        // A REC ROOM, not a gym — deliberately. No rig in this game has an exercise clip, and a gym
        // full of standing figures reads as a bug rather than as a gym. Benches, a table and a vending
        // machine are all covered by `sit`, which every staff rig has.
        //
        // The vending machine moved to the WEST wall (x=11 is real wall) from the z=26 doorway.
        ( piece: VendingMachine,pos: (40.5, 43.6), yaw: 180.0 ),
        ( piece: Bench,         pos: (41.6, 43.5), yaw:   0.0 ),
        ( piece: Bench,         pos: (43.8, 43.5), yaw:   0.0 ),
        ( piece: MessTable,     pos: (42.5, 45.5), yaw:   0.0 ),
        ( piece: Chair,         pos: (41.6, 45.5), yaw:   0.0 ),
        ( piece: Chair,         pos: (43.4, 45.5), yaw: 180.0 ),
        ( piece: Chair,         pos: (42.5, 44.6), yaw: 270.0 ),
        ( piece: Bench,         pos: (42.5, 47.6), yaw:  90.0 ),

        // ── WAR ROOM  x[18,23) z[26,34) ──
        //
        // The map table is the centrepiece and everything faces it. `SM_Holo` is the only mesh in the
        // whole Ozea library that reads as a plot of somewhere you are about to go, which is exactly
        // what this room is for.
        ( piece: MapTable,      pos: (59.5, 45.0), yaw:   0.0 ),
        ( piece: Chair,         pos: (58.2, 45.0), yaw:   0.0 ),
        ( piece: Chair,         pos: (60.8, 45.0), yaw: 180.0 ),
        ( piece: Chair,         pos: (59.5, 44.0), yaw: 270.0 ),

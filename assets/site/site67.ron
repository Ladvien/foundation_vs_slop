    // Dressing. Positions are metres from `origin`.
    props: [
        ( piece: Crate,      pos: (25.5, 15.5), yaw:   0.0 ),
        ( piece: Crate,      pos: (26.5, 15.5), yaw:  30.0 ),
        ( piece: Crate,      pos: (25.5, 16.5), yaw:  75.0 ),
        ( piece: Crate,      pos: (29.5, 17.5), yaw:  10.0 ),
        ( piece: Pipe,       pos: ( 3.0, 12.5), yaw:  90.0 ),
        ( piece: Pipe,       pos: (17.0, 12.5), yaw:  90.0 ),
        ( piece: PipeCorner, pos: (31.0, 12.5), yaw:  90.0 ),
        // Threshold pads: the door's mouth, marked diegetically rather than with a HUD prompt.
        ( piece: FloorButton, pos: ( 5.5,  3.5), yaw:  0.0 ),
        ( piece: FloorButton, pos: ( 6.5,  3.5), yaw:  0.0 ),
        ( piece: FloorButton, pos: ( 7.5,  3.5), yaw:  0.0 ),
        // The examination slab, in the middle of the research wing (x10..21, z14..23). The research
        // system has always had a "slab" — `research::lab::StudySubject` is documented as "the
        // specimen currently on the slab" and the HUD says NO SPECIMEN ON THE SLAB — and until
        // 2026-08-01 it existed only as text over an empty floor.
        ( piece: Slab,       pos: (15.5, 18.5), yaw:  90.0 ),
        // Wayfinding toward the aperture, read from the spine.
        ( piece: ArrowDecal, pos: ( 6.5, 11.5), yaw: 180.0 ),
        // The counters. `WallLow` was dressed in the kit, given a 0.9 m target and listed in
        // `SitePiece::ALL` since the Site shipped, and placed NOWHERE — the piece its own kit entry
        // describes as "the Records desk and the Requisition counter" had no author. A run along X
        // takes yaw 90, same as the walls: `wall_low.glb` is 0.20 m thin on X and 1.00 m long on Z.
        //
        // Props do not feed nav (`is_walkable` reads the `walls` list only), so a counter is walked
        // through, exactly like the crates and pipes above. That is pre-existing for all dressing.
        ( piece: WallLow,    pos: ( 2.5, 16.5), yaw:  90.0 ),   // records desk
        ( piece: WallLow,    pos: ( 3.5, 16.5), yaw:  90.0 ),
        ( piece: WallLow,    pos: ( 4.5, 16.5), yaw:  90.0 ),
        ( piece: WallLow,    pos: (27.5, 18.5), yaw:  90.0 ),   // requisition counter
        ( piece: WallLow,    pos: (28.5, 18.5), yaw:  90.0 ),
        ( piece: WallLow,    pos: (29.5, 18.5), yaw:  90.0 ),
        // Wing colour-codes — THIS is what makes the hub learnable without signage (design doc §2.1).
        ( piece: AreaDecal,  pos: ( 3.5, 17.5), yaw:   0.0 ),   // records
        ( piece: AreaDecal,  pos: (15.5, 18.5), yaw:   0.0 ),   // research
        ( piece: AreaDecal,  pos: (27.5, 16.5), yaw:   0.0 ),   // requisition
        ( piece: AreaDecal,  pos: (28.5, 25.5), yaw:   0.0 ),   // briefing
        ( piece: AreaDecal,  pos: ( 2.5, 29.5), yaw:   0.0 ),   // quarters
        ( piece: AreaDecal,  pos: ( 8.5, 29.5), yaw:   0.0 ),   // galley
        ( piece: AreaDecal,  pos: (14.5, 29.5), yaw:   0.0 ),   // activities
        ( piece: AreaDecal,  pos: (20.5, 29.5), yaw:   0.0 ),   // war room
        ( piece: AreaDecal,  pos: (31.5,  7.5), yaw:   0.0 ),   // monitoring

        // ── QUARTERS  x[0,5) z[26,34) ──
        //
        // Four bunks head-to-wall down the west side with a locker and a bedside table each, which is
        // what makes the room read as somewhere FIVE people live rather than a bedroom. Bunks run along
        // Z (yaw 0) so their long axis is the room's long axis; the aisle is the east half.
        ( piece: Bunk,          pos: ( 0.8, 27.3), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 1.8, 26.4), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 4.4, 27.0), yaw: 270.0 ),
        ( piece: Bunk,          pos: ( 0.8, 30.0), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 1.8, 29.1), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 4.4, 27.8), yaw: 270.0 ),
        ( piece: Bunk,          pos: ( 0.8, 32.7), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 1.8, 31.8), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 4.4, 28.6), yaw: 270.0 ),
        ( piece: Locker,        pos: ( 4.4, 29.4), yaw: 270.0 ),

        // ── GALLEY  x[6,11) z[26,34) ──
        //
        // Work surface and appliances along the north wall, eating in the middle. The coffee machine
        // sits ON the counter run rather than on the floor: `y_offset` is a kit fact, so it is placed
        // at counter height here by standing it on the counter's own 0.75 m top.
        ( piece: GalleyCounter, pos: ( 7.0, 26.6), yaw:  90.0 ),
        ( piece: GalleyCounter, pos: ( 8.4, 26.6), yaw:  90.0 ),
        ( piece: GalleyCounter, pos: ( 9.8, 26.6), yaw:  90.0 ),
        ( piece: CoffeeMachine, pos: ( 7.2, 27.4), yaw: 180.0 ),
        ( piece: WaterDispenser,pos: (10.5, 27.2), yaw: 180.0 ),
        ( piece: MessTable,     pos: ( 8.5, 29.5), yaw:   0.0 ),
        ( piece: Stool,         pos: ( 7.6, 29.5), yaw:  90.0 ),
        ( piece: Stool,         pos: ( 9.4, 29.5), yaw: 270.0 ),
        ( piece: MessTable,     pos: ( 8.5, 31.8), yaw:   0.0 ),
        ( piece: Stool,         pos: ( 7.6, 31.8), yaw:  90.0 ),
        ( piece: Stool,         pos: ( 9.4, 31.8), yaw: 270.0 ),

        // ── ACTIVITIES  x[12,17) z[26,34) ──
        //
        // A REC ROOM, not a gym — deliberately. No rig in this game has an exercise clip, and a gym
        // full of standing figures reads as a bug rather than as a gym. Benches, a table and a vending
        // machine are all covered by `sit`, which every staff rig has.
        ( piece: VendingMachine,pos: (12.7, 26.6), yaw: 180.0 ),
        ( piece: Bench,         pos: (13.2, 28.5), yaw:   0.0 ),
        ( piece: Bench,         pos: (15.8, 28.5), yaw:   0.0 ),
        ( piece: MessTable,     pos: (14.5, 30.5), yaw:   0.0 ),
        ( piece: Chair,         pos: (13.6, 30.5), yaw:  90.0 ),
        ( piece: Chair,         pos: (15.4, 30.5), yaw: 270.0 ),
        ( piece: Chair,         pos: (14.5, 29.6), yaw: 180.0 ),
        ( piece: Bench,         pos: (14.5, 32.6), yaw:  90.0 ),

        // ── WAR ROOM  x[18,23) z[26,34) ──
        //
        // The map table is the centrepiece and everything faces it. `SM_Holo` is the only mesh in the
        // whole Ozea library that reads as a plot of somewhere you are about to go, which is exactly
        // what this room is for.
        ( piece: MapTable,      pos: (20.5, 29.5), yaw:   0.0 ),
        ( piece: Chair,         pos: (19.2, 29.5), yaw:  90.0 ),
        ( piece: Chair,         pos: (21.8, 29.5), yaw: 270.0 ),
        ( piece: Chair,         pos: (20.5, 28.2), yaw: 180.0 ),
        ( piece: ControlDesk,   pos: (20.5, 27.0), yaw:  90.0 ),
        ( piece: ServerRack,    pos: (18.6, 32.8), yaw:   0.0 ),
        ( piece: Locker,        pos: (22.4, 32.6), yaw: 270.0 ),

        // ── MONITORING  x[30,34) z[2,12) ──
        //
        // Consoles down the WEST wall, which is the wall it shares with the containment wing. The room
        // is pointed at the thing it watches; that is the whole reason it is here rather than in the
        // south wing with the domestic rooms.
        ( piece: SurveillanceConsole, pos: (30.85,  4.0), yaw:  90.0 ),
        ( piece: SurveillanceConsole, pos: (30.85,  6.0), yaw:  90.0 ),
        ( piece: SurveillanceConsole, pos: (30.85,  8.0), yaw:  90.0 ),
        ( piece: CommandChair,        pos: (32.0,  5.0), yaw: 270.0 ),
        ( piece: CommandChair,        pos: (32.0,  7.0), yaw: 270.0 ),
        ( piece: ServerRack,          pos: (32.6, 10.4), yaw: 270.0 ),
        ( piece: ServerRack,          pos: (32.6,  2.6), yaw: 270.0 ),
    ],

    // Containment cells (FVS-D-4). Indices must be dense from 0 — specimens fill them in
    // `Specimen::captured_tick` order, so "cell 0 holds the first thing you ever caught" is stable.
    // Six is the first pass; overflow is a `warn!` and no body, never a silently dropped record.
    cells: [
        ( index: 0, pos: (15.5,  4.0), yaw: 180.0 ),
        ( index: 1, pos: (18.5,  4.0), yaw: 180.0 ),
        ( index: 2, pos: (21.5,  4.0), yaw: 180.0 ),
        ( index: 3, pos: (24.5,  4.0), yaw: 180.0 ),
        ( index: 4, pos: (27.5,  4.0), yaw: 180.0 ),
        ( index: 5, pos: (28.5,  9.0), yaw: 270.0 ),
    ],

    // The ASYNC door. Walking an avatar into the trigger calls `NextState::set(RunState::Active)` —
    // FVS-A-5 already implements that transition end to end, so the door needs NO new state machinery.
    //
    // `pos` and `frame_pos` are two different things and were conflated until 2026-08-01. `pos` is the
    // TRIGGER centre and carries a real invariant — `validate` flood-fills to it, so it must sit on
    // reachable floor, and the z=1 perimeter row is not floor and cannot host it. `frame_pos` is where
    // the FRAME stands: in the gap, on the wall line (cell centres there are z=1.5), centred on the two
    // held-clear cells at x=7.0. Placing the frame at `pos` stood it a metre out on the hall floor.
    //
    // `yaw: 90.0` because the z=1 run separates along Z — the same convention the walls header states,
    // and `doorframe_double.glb` is thin along X exactly like `SM_Wall_1x2`. It was authored 0.0, which
    // turned the frame across the run. The trigger extents corroborate the fix rather than the bug:
    // hx=1.6 is ACROSS the opening and hz=0.7 is THROUGH it, which is only true of an X-running door.
    door: (
        pos:                  (7.0, 2.5),
        frame_pos:            (7.0, 1.5),
        yaw:                  90.0,
        trigger_half_extents: (1.6, 1.2, 0.7),
    ),

    // Operatives idle in the briefing room — the far end, so leaving means walking the length of the
    // Site past the cells.
    spawns: [
        (27.5, 26.5),
        (29.0, 26.5),
        (30.5, 26.5),
        (28.0, 27.5),
        (29.8, 27.5),
    ],
)

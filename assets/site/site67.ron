// =================================================================================================
// SITE-67 — the hand-authored hub (FVS-G-4). Design: docs/2026-07-26-site-hub-and-operative-knowledge.md
//
// HAND-AUTHORED ON PURPOSE. A hub returned to after every expedition has to be LEARNABLE — you should
// know where the specimen cells are without reading a sign — and procedural generation actively fights
// that. This file is also deliberately NOT part of `config.ron`: it is level data, and the offline
// search must never evolve it, for the same reason `session:`'s win condition is excluded.
//
// COORDINATES. Cells are 1 m (`dungeon::TILE_SIZE`). `origin` places cell (0,0) in world space; walls
// and floor are on integer cells for greybox readability, props and cells are in metres so they need
// not sit on the grid.
//
// LAYOUT — two spine corridors, with every area hanging off one of them:
//
//        z=2   |  [ ASYNC DOOR HALL ]      [  CONTAINMENT WING  ] [MON] |
//        z=12  +========================= SPINE ========================+
//        z=14  |  [ RECORDS ] | [  RESEARCH  ]  [REQ]  \_connector_/    |
//        z=22  |              |               |        [ BRIEFING ]     |
//        z=24  +=================== SOUTH SPINE ========+ [ BRIEFING ]   |
//        z=26  | [QUARTERS] [GALLEY] [ACTIV] [WAR ROOM] | [ BRIEFING ]   |
//        z=34  +---------------------------------------+                 |
//              x=0                                                    x=34
//
// The operatives idle in the briefing room, so reaching the door is a walk THROUGH the Site — past the
// cells holding what you already caught. That is the loop made spatial, and it is why the briefing room
// is the far end rather than beside the door.
//
// THE LIVING HALF (2026-08-02) — quarters, galley, activities, war room, monitoring.
//
// The first six areas each existed because a MECHANIC needed a location (design doc §2.4 names the
// system in every row). These five invert that: the space comes first, because a site that contains
// anomalies is also somewhere people sleep and eat, and a hub with none of that reads as a facility
// diagram. Director's call, stated here because it is the opposite of the rule the first six followed.
//
// Monitoring, the connector and the south spine fit in voids that were ALREADY INSIDE the perimeter —
// the column between records and research, the block south of research, and the strip east of
// containment. The four south ROOMS then run 8 deep, which does extend the building south: floor grows
// 664 -> 932 cells and the bounding box goes from z[2,29] to z[2,33].
//
// That extension is deliberate and it is only in one direction. `docs/2026-08-01-two-live-layers.md`
// made visit duration a priced resource — time at the Site is time the expedition is unsupervised — so
// growing the hub is not free. The south wing is a DESTINATION rather than something on the way to the
// ASYNC door, so its depth is paid only by a player who chooses to go there, and the walk from the
// briefing room to the door is exactly as long as it was.
//
// The WAR ROOM and MONITORING are `RunState::Idle` only. §5 of that same doc records that supervising
// the squad you left unattended was deliberately blocked; these rooms plan the NEXT expedition and
// review the LAST one, and go dark during a live visit.
// =================================================================================================
(
    // Far outside any dungeon extent. The Site's isolation from fog, the knee-wall cutaway, the light
    // field, mould and almond water is achieved by DISTANCE — all of those are dungeon-grid indexed and
    // simply never reach out here. One mechanism, rather than a Visibility toggle on every Site entity
    // at every state change. `layout::tests` pins the clearance.
    origin: (1024.0, 0.0, 1024.0),

    areas: [
        ( id: AsyncDoor,   label: "ASYNC APERTURE",  rect: (x:  0, z:  2, w: 12, h: 10) ),
        ( id: Containment, label: "CONTAINMENT",     rect: (x: 14, z:  2, w: 16, h: 10) ),
        ( id: Monitoring,  label: "MONITORING",      rect: (x: 30, z:  2, w:  4, h: 10) ),
        ( id: Corridor,    label: "SPINE",           rect: (x:  0, z: 12, w: 34, h:  2) ),
        ( id: Records,     label: "RECORDS",         rect: (x:  0, z: 14, w:  8, h:  8) ),
        ( id: Research,    label: "RESEARCH",        rect: (x: 10, z: 14, w: 12, h: 10) ),
        ( id: Requisition, label: "REQUISITION",     rect: (x: 24, z: 14, w:  8, h:  6) ),
        ( id: Briefing,    label: "BRIEFING",        rect: (x: 24, z: 22, w: 10, h:  8) ),
        // The living half (2026-08-02). Four rooms off the south spine.
        ( id: Quarters,    label: "QUARTERS",        rect: (x:  0, z: 26, w:  5, h:  8) ),
        ( id: Kitchen,     label: "GALLEY",          rect: (x:  6, z: 26, w:  5, h:  8) ),
        ( id: Activities,  label: "ACTIVITIES",      rect: (x: 12, z: 26, w:  5, h:  8) ),
        ( id: WarRoom,     label: "WAR ROOM",        rect: (x: 18, z: 26, w:  5, h:  8) ),
    ],

    // Rect RUNS, not per-cell: a 16x10 wing is one row instead of 160, and `site::nav`'s walkable mask
    // falls out of this for free. Every area rect appears here; the extra entry is the short connector
    // that joins requisition to the briefing room (floor that belongs to no area is fine).
    floor: [
        (x:  0, z:  2, w: 12, h: 10),   // async door hall
        (x: 14, z:  2, w: 16, h: 10),   // containment wing
        (x: 30, z:  2, w:  4, h: 10),   // monitoring — beside the cells it watches
        (x:  0, z: 12, w: 34, h:  2),   // the spine
        (x:  0, z: 14, w:  8, h:  8),   // records office
        (x:  8, z: 14, w:  2, h: 10),   // connector: spine -> south spine
        (x: 10, z: 14, w: 12, h: 10),   // research wing
        (x: 24, z: 14, w:  8, h:  6),   // requisition
        (x: 26, z: 20, w:  2, h:  2),   // connector: requisition -> briefing
        (x: 24, z: 22, w: 10, h:  8),   // briefing room
        (x:  0, z: 24, w: 24, h:  2),   // the SOUTH spine
        (x:  0, z: 26, w:  5, h:  8),   // quarters
        (x:  6, z: 26, w:  5, h:  8),   // galley
        (x: 12, z: 26, w:  5, h:  8),   // activities
        (x: 18, z: 26, w:  5, h:  8),   // war room
    ],

    // THE PERIMETER — generated, not hand-typed, by walking every non-floor cell orthogonally
    // adjacent to floor, PLUS every cell that touches floor only DIAGONALLY
    // (`scripts/gen_site_perimeter.py`).
    // Hand-typing ~220 entries is how a gap gets left in a wall that nobody notices for a month.
    //
    // The diagonal half is each room's convex (outer) corner — 16 cells, one per outside corner —
    // and it was missing until 2026-08-01, which left an open notch you could see straight through at
    // each. Found by screenshotting the perimeter, not by a test.
    //
    // What this list is FOR, as of the 2026-08-01 rewrite: it states which cells are wall, which is
    // what `is_walkable` and `SiteLayout::validate` read. It no longer says where a wall FACE is.
    // `site::visuals::wall_panels` derives that from FLOOR EDGES — one 1 m panel per floor-cell edge
    // whose neighbour is a wall cell — and `corner_vertices` caps the lattice points where two
    // perpendicular panels meet (28 of them). Two consequences worth knowing before editing below:
    //
    //   * `yaw` on a `Wall` row is not read by the spawner any more. It is retained because it still
    //     documents the run's direction for a human, and `gen_site_perimeter.py` still emits it.
    //   * The 16 diagonal-only cells emit no panel of their own (they share no EDGE with any floor
    //     cell, only a corner). They are still the truth about which cells are wall, and their
    //     corner is capped by the two runs that meet there.
    //
    // Non-`Wall` pieces on this list — a column standing in a run, say — are still placed at their
    // cell centre with their authored yaw: those are furniture on a cell, not a face on an edge.
    //
    // Safe by construction: `is_walkable = is_floor && !wall`, and every cell below is NOT floor, so
    // no wall here can change walkability or break `SiteLayout::validate`'s connectivity flood-fill.
    // The two cells the ASYNC aperture occupies (x=6..7, z=1) are held clear so the doorway the
    // spawner places is not bricked up behind a wall. TWO, not four: `doorframe_double.glb` spans
    // 2.003 m, so centred on the gap it covers exactly these two. Holding x=5..8 clear — as this did
    // until 2026-08-01 — left a metre of open perimeter either side of the frame with nothing in it.
    // `SiteLayout::validate` now checks the frame's span against the gap, so the two cannot drift.
    //
    // Openings are the ABSENCE of wall: the wings meet the spine along z=12/z=14 with nothing between
    // them, which is why the flood-fill still reaches every area.
    //
    // Yaw is degrees about +Y. The Ozea wall is 0.10 m thin along X and 1.00 m long along Z, so a wall
    // separating along X takes yaw 0 and one separating along Z takes yaw 90.
    walls: [
        ( piece: Wall,       cell: ( -1,  1), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  1), yaw:  90.0 ),
        ( piece: Wall,       cell: ( -1,  2), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  3), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  4), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  5), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  6), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  7), yaw:   0.0 ),
        ( piece: Wall,       cell: ( -1,  8), yaw:   0.0 ),

        ( piece: WallLow,    pos: (41.5, 23.5), yaw:  90.0 ),
        // Wing colour-codes — THIS is what makes the hub learnable without signage (design doc §2.1).
        ( piece: AreaDecal,  pos: ( 9.5, 22.5), yaw:   0.0 ),   // records
        ( piece: AreaDecal,  pos: (25.5, 23.5), yaw:   0.0 ),   // research
        ( piece: AreaDecal,  pos: (39.5, 21.5), yaw:   0.0 ),   // requisition
        ( piece: AreaDecal,  pos: (52.5, 22.5), yaw:   0.0 ),   // briefing
        ( piece: AreaDecal,  pos: ( 8.5, 38.5), yaw:   0.0 ),   // quarters
        ( piece: AreaDecal,  pos: ( 17.5, 38.5), yaw:   0.0 ),   // galley
        ( piece: AreaDecal,  pos: (26.5, 38.5), yaw:   0.0 ),   // activities
        ( piece: AreaDecal,  pos: (35.5, 38.5), yaw:   0.0 ),   // war room
        ( piece: AreaDecal,  pos: (51.5,  7.5), yaw:   0.0 ),   // monitoring

        // ── QUARTERS  x[0,5) z[26,34) ──
        //
        // Four bunks head-to-wall down the west side with a locker and a bedside table each, which is
        // what makes the room read as somewhere FIVE people live rather than a bedroom. Bunks run along
        // Z (yaw 0) so their long axis is the room's long axis; the aisle is the east half.
        //
        // ⚠️ EVERYTHING HERE MOVED SOUTH ON 2026-08-02, and the reason applies to all four south rooms.
        // These were authored against a "north wall" that does not exist: the room's entire z=26 edge is
        // its way in from the south spine (openings in Site-67 are the ABSENCE of wall, so a room can be
        // open along a whole side). Furniture on that edge was standing in the doorway.
        // `check_prop_placements` now derives every threshold and refuses this — see THRESHOLD_CLEAR.
        ( piece: Bunk,          pos: ( 6.8, 37.1), yaw:  90.0 ),
        ( piece: BedsideTable,  pos: ( 7.8, 36.4), yaw:   0.0 ),
        ( piece: Locker,        pos: ( 10.4, 36.5), yaw: 270.0 ),

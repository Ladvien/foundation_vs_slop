// Ozea's low-poly sci-fi facility set. **Names pieces; does not describe them** — the
// measurements are in assets/emerge/site/library.ron and this facility's architecture (2.4 m
// walls, 2.0 m doorways, a 0.9 m counter) is in project.ron beside it.
//
// Every piece is a named field with deny_unknown_fields, so a kit that forgets one fails at
// PARSE time naming the field. That is the guarantee this file exists to keep; the art moved
// out from under it on 2026-08-03 and the guarantee did not.
(
    trash_bin: "site/trash_bin",
    pallet: "site/pallet",
    step_ladder: "site/step_ladder",
    storage_box: "site/storage_box",
    storage_crate: "site/storage_crate",
    utility_cart: "site/utility_cart",
    tube_rack: "site/tube_rack",
    data_folder: "site/data_folder",
    medical_vial: "site/medical_vial",
    mug: "site/mug",
    books: "site/books",
    floor: "site/floor",
    wall: "site/wall",
    wall_corner: "site/wall_corner",
    wall_doorway: "site/wall_doorway",
    wall_doorway_wide: "site/wall_doorway_wide",
    wall_header: "site/wall_header",
    wall_window: "site/wall_window",
    door_plaque: "site/door_plaque",
    wall_low: "site/wall_low",
    slab: "site/slab",
    column: "site/column",
    crate_: "site/crate",
    pipe: "site/pipe",
    pipe_corner: "site/pipe_corner",
    floor_button: "site/floor_button",
    area_decal: "site/area_decal",
    arrow_decal: "site/arrow_decal",
    specimen_standin: "site/specimen_standin",
    bunk: "site/bunk",
    locker: "site/locker",
    bedside_table: "site/bedside_table",
    galley_counter: "site/galley_counter",
    mess_table: "site/mess_table",
    stool: "site/stool",
    coffee_machine: "site/coffee_machine",
    water_dispenser: "site/water_dispenser",
    bench: "site/bench",
    vending_machine: "site/vending_machine",
    chair: "site/chair",
    map_table: "site/map_table",
    control_desk: "site/control_desk",
    surveillance_console: "site/surveillance_console",
    server_rack: "site/server_rack",
    command_chair: "site/command_chair",

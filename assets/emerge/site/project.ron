(
    version: 1,
    note: Some("SCP-9191\'s architecture over the Site kit\'s measurements. Originally generated, but that generator no longer exists anywhere in the tree — hand-maintained now. tests/site_descriptors.rs checks the heights these patches produce."),
    // How finely each authoring tile divides, for every piece's lattice. 1 means a subunit is
    // `grid::SNAP` itself -- the half-metre grid these kits are already authored on, on which a
    // 3 m wall is 6 divisions across and a 2.4 m one is 5 layers tall. Raising it refines every
    // piece in the project by the same factor, which is what keeps two faces comparable.
    divisions: 1,
    patches: [
        (
            match: Id("site/wall"),
            because: "this facility builds Wall to 2.40 m; the mesh is authored at 2.40 m",
            patch: (
                id: "",
                mesh: None,
                align: (
                    scale: None,
                    stretch_y: Some(1.0),
                    y_offset: None,
                    pivot: None,
                    front: None,
                ),
                extent: (
                    footprint: None,
                    height: None,
                ),
                mount: None,
                clearance: [],
                offers: (
                    surfaces: [],
                    sockets: [],
                ),
                kind: [],
                effects: [],
                look: [],
                placement: (
                    rooms: [],
                    group: None,
                ),
                note: None,
            ),
        ),

// **What each rig's clips are and how they play.**
//
// The numbers here were measured off the GLBs, not chosen. `emerge_core::clips` can re-measure any of
// them from the asset (`cycle_distance`, `phase_offset`, `duration`), and
// `crates/emerge-core/tests/rigs_match_assets.rs` fails the build when this file and the file it
// describes disagree — which is the point: re-measuring a re-exported rig stops being a code edit.
//
// **Slot order is the contract.** The index of a slot is the handle the game's drivers use
// (`anim::blend`'s SLOT_IDLE, SLOT_WALK, ...). Reordering this list re-wires the creature.
// A `note` is documentation and resolves nothing — the Valkyrie's strafe clips are named backwards in
// the asset, and the code has always wired them by measured direction.
//
// **`scale` is the render scale the game applies at spawn**, and therefore the factor that turns a
// distance measured in the GLB's file units into the world units `cycle_distance` is declared in.
// One copy, here — the spawners read it from this file (v2 made it required; the five per-module
// literals it replaced are gone).
//
// Other per-rig fields: `drive_speed: (min, max)` is the world-speed range the game drives a gaited
// rig at (v3) — the skate check compares it against each gait's authored speed, and a game-side test
// (`src/rigs.rs`) pins it to the shipped movement config; `root_node:`/`contact_joints:` name the
// measurement anchors when an exporter does not use the conventional `Root`/`foot_l`; `provenance:`
// is the bench's adopt stamp (file hash, clip list, date) and is TOOL-OWNED — never hand-edit it.
// Per-slot: `keep: Some("why")` makes adopt leave that slot's numbers alone, `tolerance: Some(f)`
// pins its own drift margin.
(
    version: 3,
    note: Some("Measured with emerge_core::clips. See docs/artist_guide.md §4 for the authoring contract."),
    rigs: {
        "valkyrie": (
            mesh: "characters/valkyrie.glb",
            scale: 1.13,
            // Squad realized range: unit_speed 6.0 × the min_encumber 0.15 floor (config.ron,
            // squad_move); the hub avatar's 3.2 walks inside it. Pinned by src/rigs.rs.
            drive_speed: Some((0.9, 6.0)),
            // Hand-validated against docs/artist_guide.md §4's table. The derived (log-Otsu)
            // thresholds reproduce five of the six gaits, but run_back's transition-heavy
            // histogram derives past the 20% drift guard — see clips::otsu_threshold's table.
            contact_eps: Some(0.35),
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 1, playback: Free(speed: 1.0), note: Some("idle_alert")),
                (clip: 5, playback: Gait(duration: 1.417, phase_offset: 0.0, cycle_distance: 1.388), note: Some("walk — the phase reference all the others are measured against")),
                (clip: 11, playback: Gait(duration: 0.75, phase_offset: -0.016, cycle_distance: 2.135), note: Some("run")),
                (clip: 8, playback: Gait(duration: 1.458, phase_offset: -0.141, cycle_distance: 1.538), note: Some("walk_back")),
                (clip: 12, playback: Gait(duration: 0.583, phase_offset: -0.062, cycle_distance: 1.185), note: Some("run_back")),
                (clip: 14, playback: Gait(duration: 0.583, phase_offset: 0.047, cycle_distance: 1.259), note: Some("carries the body LEFTWARD — the asset names this clip strafe_r")),
                (clip: 13, playback: Gait(duration: 0.708, phase_offset: -0.031, cycle_distance: 1.937), note: Some("carries the body RIGHTWARD — the asset names this clip strafe_l")),
                (clip: 3, playback: Free(speed: 1.0), mask: Some(0), note: Some("aim — upper body only, over whatever the legs are doing")),
                (clip: 4, playback: OneShot(speed: 1.0), mask: Some(0), note: Some("fire")),
            ],
        ),
        // **No gaits below this line.** A scuttle and a chomp share no cycle, so there is nothing to
        // phase-lock: these clips loop at their own authored speed and only their weight moves. That
        // is also why none of them carries a cycle distance — they do not derive cadence from ground
        // speed, so `emerge_core::clips::cycle_distance` has nothing to check them against.
        "crab": (
            mesh: "dimensional_crab/dimensional_crab.glb",
            scale: 0.15,
            slots: [
                (clip: 1, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 7.0), note: Some("walk — 7x, a scuttle reads fast")),
                (clip: 0, playback: Free(speed: 4.0), note: Some("attack")),
            ],
        ),
        // The glb stores its 12 clips ALPHABETICALLY, which is why these indices look unordered.
        "manca": (
            mesh: "scp150/scp-150.glb",
            scale: 0.07,
            slots: [
                (clip: 7, playback: Free(speed: 1.0), note: Some("Idle_Snug — the dormant huddle")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("Idle_Alert")),
                (clip: 10, playback: Free(speed: 2.0), note: Some("Walk1")),
                (clip: 3, playback: Free(speed: 2.0), note: Some("Climb")),
                (clip: 1, playback: Free(speed: 1.6), note: Some("Attack2 — pounce-bite")),
                (clip: 2, playback: OneShot(speed: 0.8), note: Some("BurrowOut — the eruption")),
            ],
        ),
        "scp610": (
            mesh: "scp610/scp-610.glb",
            scale: 1.0,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 4, playback: OneShot(speed: 1.0), note: Some("death")),
            ],
        ),
        // **The eight staff bodies share one clip table** — same four slots, same indices, a
        // different GLB each. They are listed separately rather than folded into one entry with a
        // list of meshes because a rig IS its mesh here: when one body is re-exported on its own,
        // the drift guard has to be able to fail for that body and not the other seven.
        //
        // Four of the twenty clips in each asset are wired. The other sixteen are loaded by nothing,
        // deliberately: a slot nobody drives is a weight that is always zero.
        "researcher": (
            mesh: "characters/researcher.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "scientist": (
            mesh: "characters/scientist.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "fieldop": (
            mesh: "characters/fieldop.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "makarov": (
            mesh: "characters/makarov.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "cipher_standard": (
            mesh: "characters/cipher_standard.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "cipher_senior": (
            mesh: "characters/cipher_senior.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "cipher_field": (
            mesh: "characters/cipher_field.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        "cipher_hazmat": (
            mesh: "characters/cipher_hazmat.glb",
            scale: 1.13,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), note: Some("idle")),
                (clip: 2, playback: Free(speed: 1.0), note: Some("idle_look")),
                (clip: 4, playback: Free(speed: 1.0), note: Some("walk")),
                (clip: 6, playback: Free(speed: 1.0), note: Some("jog")),
            ],
        ),
        // **The four SCP-1048 variants ship DIFFERENT clip sets**, which is why these are the only
        // slots carrying a `state`. A driver asks a bear for a state and the variant answers with a
        // slot or with nothing - only the original can draw, and SCP-1048-A cannot dance. Position
        // alone cannot say "this variant does not have one".
        // SCP-1048, the benign original - all five clips wired.
        "scp1048_original": (
            mesh: "scp1048/scp-1048.glb",
            scale: 1.0,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), state: Some("rest_idle"), note: Some("idle")),
                (clip: 1, playback: Free(speed: 1.0), state: Some("dance"), note: Some("dance")),
                (clip: 2, playback: OneShot(speed: 1.0), state: Some("jump"), note: Some("jump")),
                (clip: 3, playback: Free(speed: 1.0), state: Some("draw"), note: Some("draw - only the original can")),
                (clip: 4, playback: OneShot(speed: 1.0), state: Some("sit_down"), note: Some("sit_down")),
            ],
        ),
        // SCP-1048-A, the ear bear - all five wired. `scream` is a one-shot attack that returns to neutral.
        "scp1048_ear": (
            mesh: "scp1048a/scp-1048-a.glb",
            scale: 1.0,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), state: Some("rest_idle"), note: Some("idle")),
                (clip: 1, playback: OneShot(speed: 1.0), state: Some("jump"), note: Some("jump")),
                (clip: 2, playback: OneShot(speed: 1.0), state: Some("sit_down"), note: Some("sit_down")),
                (clip: 3, playback: OneShot(speed: 1.0), state: Some("attack"), note: Some("scream")),
                (clip: 4, playback: Free(speed: 1.0), state: Some("rage"), note: Some("rage")),
            ],
        ),
        // SCP-1048-B, the infant-arm bear - all six wired.
        "scp1048_infant": (
            mesh: "scp1048b/scp-1048-b.glb",
            scale: 1.0,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), state: Some("rest_idle"), note: Some("idle")),
                (clip: 1, playback: Free(speed: 1.0), state: Some("dance"), note: Some("dance")),
                (clip: 2, playback: OneShot(speed: 1.0), state: Some("jump"), note: Some("jump")),
                (clip: 3, playback: OneShot(speed: 1.0), state: Some("sit_down"), note: Some("sit_down")),
                (clip: 4, playback: Free(speed: 1.0), state: Some("attack"), note: Some("tantrum - LOOPS. Authored as a looping fit with two flail cycles per pass, so it is held as a state for as long as the bear is attacking rather than triggered as an event. The one attack in the codebase that loops.")),
                (clip: 5, playback: Free(speed: 1.0), state: Some("rage"), note: Some("rage")),
            ],
        ),
        // SCP-1048-C, the rusted scrap bear - seven of its eight clips. `scp1048c_dance` (index 1) is deliberately NOT wired: it is legacy motion inherited from the benign original and reads wrong on a violent copy. The contract test still pins its index, so a re-export that drops it - which would shift every hostile clip below it - fails loudly.
        "scp1048_scrap": (
            mesh: "scp1048c/scp-1048-c.glb",
            scale: 1.0,
            slots: [
                (clip: 0, playback: Free(speed: 1.0), state: Some("rest_idle"), note: Some("idle")),
                (clip: 2, playback: OneShot(speed: 1.0), state: Some("jump"), note: Some("jump")),
                (clip: 3, playback: OneShot(speed: 1.0), state: Some("sit_down"), note: Some("sit_down")),
                (clip: 4, playback: OneShot(speed: 1.0), state: Some("aim"), note: Some("aim")),
                (clip: 5, playback: OneShot(speed: 1.0), state: Some("fire"), note: Some("fire")),
                (clip: 6, playback: OneShot(speed: 1.0), state: Some("whip"), note: Some("whip")),
                (clip: 7, playback: Free(speed: 1.0), state: Some("rage"), note: Some("rage")),
            ],
        ),
    },
)

    // dialogue — authored conversation graph (see `DialogueScript`/`Node` in src/dialogue/model.rs).
    // A set of named conversations; each is a node graph keyed by id. Speakers are squad-member
    // indices 0..=4 (0 = leader). `kind` defaults to Speech; `emotion` defaults to Neutral. `Line`
    // advances to `next` (None ends the conversation); `Choice` presents clickable option bubbles
    // above the leader and branches on the pick. Cloned into a `DialogueScript` resource at startup.
    // =============================================================================================
    dialogue: (
        conversations: {
            // ── THE LOOP, once each ────────────────────────────────────────────────────────────
            // Speaker roles are consistent across the corpus and are the "role voice" FVS-K-3 asks
            // for: 0 team lead (procedural, terse), 1 xenobiologist (curious past the point of
            // comfort), 2 research analyst (cites the document), 3 security (blunt), 4 medic (the
            // one who says the human thing). A line is assigned to whoever it costs something.
            "first_capture": (
                start: "held",
                nodes: {
                    "held": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Surprise,
                        text: "Containment confirmed. It's... in the field. It's actually in the field.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Joy,
                        text: "Do you understand what we just did? We didn't kill it. We UNDERSTOOD it, and it stopped.",
                        next: Some("lead"),
                    ),
                    "lead": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Calm,
                        text: "Log it and keep your eyes up. Understanding one of them is not understanding the rest.",
                        next: Some("dread"),
                    ),
                    "dread": Line(
                        speaker: 3,
                        kind: Thought,
                        emotion: Fear,
                        text: "Killing it, I'd know what I did. This thing is alive in a box and it's coming home with us.",
                        next: None,
                    ),
                },
            ),
            "first_research": (
                start: "done",
                nodes: {
                    "done": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Calm,
                        text: "Battery complete. The posterior's resolved — we can write it down as a fact now, not a guess.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Neutral,
                        text: "A fact the Foundation didn't have this morning. That's the whole job, and nobody will ever read it.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 0,
                        prompt: "What does it buy us?",
                        options: [
                            (text: "Something we can use in the field.", next: "use"),
                            (text: "Something we can tell the next squad.", next: "tell"),
                        ],
                    ),
                    "use": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Calm,
                        text: "Thaumiel doctrine — one anomaly's property becomes the tool that holds the next one. Check the tree.",
                        next: None,
                    ),
                    "tell": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Calm,
                        text: "It goes in the write-up. Every operative after us gets to start where we finished.",
                        next: None,
                    ),
                },
            ),
            "capability_unlock": (
                start: "grant",
                nodes: {
                    "grant": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Surprise,
                        text: "Site's cleared a new procedure. Derived straight off what we learned from the specimen.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Joy,
                        text: "Thaumiel. We use the anomalies to hold the anomalies. There's a joke in there and I'm too tired to find it.",
                        next: Some("lead"),
                    ),
                    "lead": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Then we can reach something we couldn't reach yesterday. That's the only kind of progress this job has.",
                        next: None,
                    ),
                },
            ),
            "home_with_specimen": (
                start: "arrive",
                nodes: {
                    "arrive": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Calm,
                        text: "Site-67. Hand it off to containment and go get some sleep.",
                        next: Some("med"),
                    ),
                    "med": Line(
                        speaker: 4,
                        kind: Thought,
                        emotion: Sadness,
                        text: "Everyone came back. I keep waiting to stop counting, and I don't think I will.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Neutral,
                        text: "It's in a cell now. Behind glass, where I can look at it properly. That's the best day I've had here.",
                        next: None,
                    ),
                },
            ),
            "operative_lost": (
                start: "call",
                nodes: {
                    "call": Line(
                        speaker: 4,
                        kind: Speech,
                        emotion: Sadness,
                        text: "I've got nothing. They're gone.",
                        next: Some("lead"),
                    ),
                    "lead": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Anger,
                        text: "Mark the position. We are not leaving them here, but we are not dying beside them either. Move.",
                        next: Some("loss"),
                    ),
                    "loss": Line(
                        speaker: 2,
                        kind: Thought,
                        emotion: Sadness,
                        text: "Everything they'd learned out here went with them. None of it was ever written down.",
                        next: None,
                    ),
                },
            ),
            "squad_wipe": (
                start: "room",
                nodes: {
                    "room": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Sadness,
                        text: "The Council will want the report before the bodies are logged. They always do.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 2,
                        prompt: "How do we write it?",
                        options: [
                            (text: "Exactly what happened. All of it.", next: "honest"),
                            (text: "What they need to send the next squad.", next: "useful"),
                        ],
                    ),
                    "honest": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Then it goes in the archive unedited. Someone reads it in six months and doesn't make our mistake.",
                        next: None,
                    ),
                    "useful": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Fear,
                        text: "Careful. A write-up that's only useful is how a thing that isn't true ends up on the shelf forever.",
                        next: None,
                    ),
                },
            ),

            // ── FIRST CONTACT, one per anomaly the roster actually ships ───────────────────────
            "contact_comfort_blob": (
                start: "see",
                nodes: {
                    "see": Line(
                        speaker: 4,
                        kind: Speech,
                        emotion: Surprise,
                        text: "There's something orange in the corridor and it is... coming toward me. Slowly. Cheerfully.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Joy,
                        text: "SCP-999. Do NOT shoot it. It has never hurt anything — it goes to whoever's most frightened.",
                        next: Some("lead"),
                    ),
                    "lead": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Calm,
                        text: "Weapons down, then. It settles when you keep your attention on it. Just... stand there and let it.",
                        next: None,
                    ),
                },
            ),
            "contact_builder_bear": (
                start: "see",
                nodes: {
                    "see": Line(
                        speaker: 3,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Contact. It's a teddy bear. It's a teddy bear and it's building something.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Calm,
                        text: "SCP-1048. The original is harmless — genuinely, provably harmless. Watch it and it stops working.",
                        next: Some("warn"),
                    ),
                    "warn": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Fear,
                        text: "What it BUILDS is the problem. If you find a second bear, it is not this bear.",
                        next: None,
                    ),
                },
            ),
            // SCP-610. Deliberately gives the player the containment doctrine as an ARGUMENT rather
            // than a tooltip: the flesh cannot be persuaded or killed usefully, so the scene's job is to
            // land "wall it off" as the only verb, and to make the mutation morph mean something by
            // naming what the thing used to be before the player watches it finish turning.
            "contact_flesh": (
                start: "see",
                nodes: {
                    "see": Line(
                        speaker: 3,
                        kind: Speech,
                        emotion: Fear,
                        text: "Contact. It's not moving. I don't think it can.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Fear,
                        text: "SCP-610. Look at the hands — that was a person this morning. It's still finishing.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 0,
                        prompt: "Call it.",
                        options: [
                            (text: "Burn it out.", next: "burn"),
                            (text: "Cordon the room.", next: "cordon"),
                        ],
                    ),
                    "burn": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Fear,
                        text: "With what? Every piece you cut off is another one of it. Fire is how sites get lost.",
                        next: Some("cordon"),
                    ),
                    "cordon": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Quarantine the room and hold the line. Quietly — it settles when we stop making noise.",
                        next: None,
                    ),
                },
            ),
            "contact_parasite": (
                start: "see",
                nodes: {
                    "see": Line(
                        speaker: 4,
                        kind: Speech,
                        emotion: Fear,
                        text: "Host down — no, host standing. Something's inside them and it's steering.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Neutral,
                        text: "SCP-150. It replaces a part and wears the rest. The host is still in there until it isn't.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 0,
                        prompt: "Call it.",
                        options: [
                            (text: "We treat the host.", next: "cure"),
                            (text: "We put them down.", next: "kill"),
                        ],
                    ),
                    "cure": Line(
                        speaker: 4,
                        kind: Speech,
                        emotion: Calm,
                        text: "Then hold it still and give me hands. This is the only containment on the roster that's also medicine.",
                        next: None,
                    ),
                    "kill": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Sadness,
                        text: "And we learn nothing, and the host dies, and the next one arrives exactly as ignorant. Your call, sir.",
                        next: None,
                    ),
                },
            ),
            "contact_crabs": (
                start: "see",
                nodes: {
                    "see": Line(
                        speaker: 3,
                        kind: Speech,
                        emotion: Anger,
                        text: "Nest. Big one. They're coming out faster than I can drop them.",
                        next: Some("analyst"),
                    ),
                    "analyst": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Don't count them, cap the source. One at a time they're nothing — it's the density that kills.",
                        next: Some("cost"),
                    ),
                    "cost": Line(
                        speaker: 1,
                        kind: Thought,
                        emotion: Sadness,
                        text: "Sealing it means no specimen. We destroy the only copy and write down what we saw. That's the trade.",
                        next: None,
                    ),
                },
            ),

            // ── SCP-9191, seeded early so FVS-K-4 only has to choose the moment ────────────────
            "slop_first_sign": (
                start: "wrong",
                nodes: {
                    "wrong": Line(
                        speaker: 3,
                        kind: Speech,
                        emotion: Fear,
                        text: "That's the second bear. It's got the same face. It has the SAME FACE and the proportions are wrong.",
                        next: Some("bio"),
                    ),
                    "bio": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Fear,
                        text: "It's a copy. Something looked at 1048 and made another one without understanding what it was looking at.",
                        next: Some("analyst"),
                    ),
                    "analyst": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Neutral,
                        text: "That's a generator, not an anomaly. The original is a thing. This is an OUTPUT.",
                        next: Some("lead"),
                    ),
                    "lead": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Anger,
                        text: "Then somewhere there's a source, and it doesn't know what it's doing. Kill this one. Flag it.",
                        next: None,
                    ),
                },
            ),
            "slop_pattern": (
                start: "count",
                nodes: {
                    "count": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Two procedures derived, two write-ups filed, and I've found the same defect in both specimens.",
                        next: Some("what"),
                    ),
                    "what": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Surprise,
                        text: "Define defect.",
                        next: Some("explain"),
                    ),
                    "explain": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Fear,
                        text: "Detail in the wrong places. Enormous care spent on things that don't matter, and none on the things that do.",
                        next: Some("bio2"),
                    ),
                    "bio2": Line(
                        speaker: 1,
                        kind: Thought,
                        emotion: Fear,
                        text: "That isn't a species trait. That's a signature. Something is producing these, and it's producing them badly.",
                        next: None,
                    ),
                },
            ),
            "slop_signature": (
                start: "shelf",
                nodes: {
                    "shelf": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Surprise,
                        text: "There's a report on the shelf I didn't file. Nobody filed it. The author field is empty.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 0,
                        prompt: "Is it wrong?",
                        options: [
                            (text: "Pull it. We don't archive what we can't source.", next: "purge"),
                            (text: "Leave it. Check it against a specimen first.", next: "verify"),
                        ],
                    ),
                    "purge": Line(
                        speaker: 2,
                        kind: Speech,
                        emotion: Calm,
                        text: "Purging it. An unsourced claim in the archive gets briefed to every squad after us as if it were earned.",
                        next: Some("close"),
                    ),
                    "verify": Line(
                        speaker: 1,
                        kind: Speech,
                        emotion: Neutral,
                        text: "Then we go and look at the thing itself. Firsthand beats a document — that's the only rule that always holds.",
                        next: Some("close"),
                    ),
                    "close": Line(
                        speaker: 1,
                        kind: Thought,
                        emotion: Fear,
                        text: "It didn't just make the monsters. It's writing to us now. It wants to be believed.",
                        next: None,
                    ),
                },
            ),
            "intro": (
                start: "open",
                nodes: {
                    "open": Line(
                        speaker: 0,
                        kind: Speech,
                        text: "Foundation, we're through the airlock. Containment breach ahead.",
                        next: Some("dread"),
                    ),
                    "dread": Line(
                        speaker: 1,
                        kind: Thought,
                        emotion: Fear,
                        text: "Whatever SCP-9191 made... it's still in here with us.",
                        next: Some("ask"),
                    ),
                    "ask": Choice(
                        speaker: 0,
                        prompt: "How do we play this?",
                        options: [
                            (text: "Push forward, weapons hot.", next: "push"),
                            (text: "Hold and sweep the room first.", next: "hold"),
                        ],
                    ),
                    "push": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Anger,
                        text: "Copy. Stack up and move — don't give it time to think.",
                        next: Some("close"),
                    ),
                    "hold": Line(
                        speaker: 0,
                        kind: Speech,
                        emotion: Calm,
                        text: "Smart. Eyes on the corners. Nobody moves until it's clear.",
                        next: Some("close"),
                    ),
                    "close": Line(
                        speaker: 1,
                        kind: Thought,
                        emotion: Calm,
                        text: "Okay. Stay sharp. We've got this.",
                        next: None,
                    ),
                },
            ),
        },
    ),
    // =============================================================================================
    // lighting — diegetic fluorescent fixtures + environment fill (see `light::LightingConfig`).
    // Fixtures are placed as furniture (`category: "light"`, `affordances: ["emit"]`); each becomes one
    // real clustered PointLight in the windowed game. ambient/directional are the flat Backrooms fill,
    // read by `world::WorldPlugin` (also present in the headless harness — pure light data).
    // =============================================================================================
    lighting: (
        ambient_brightness: 12.0,              // 500 -> 200 -> 12. This is now only a black-crush floor; the
                                               // ambient fill itself moved to env_brightness below, because a
                                               // uniform term is normal-blind and cannot shade anything.
        ambient_color: (1.0, 0.98, 0.9),       // tint of that residual floor — warm fluorescent white
        key_illuminance: 6000.0,               // steep directional KEY (lux). Was 2000, when it was a token
                                               // fill under a 200-brightness uniform ambient and nothing cast
                                               // shadows. It is now the game's only shadow caster, so it has
                                               // to actually out-run the env fill — a shadow only subtracts
                                               // the directional term, so key:fill is exactly the contrast
                                               // ratio of every shadow on screen.
        fixture_intensity: 120000.0,           // per-fixture lumens (Bevy's default cinema light = 1e6)
        fixture_range: 7.0,                    // metres — area-of-effect cutoff, tuned with intensity
        fixture_color: (0.92, 1.0, 0.94),      // cool white, faint green cast (low-CRI halophosphate)
        fixture_emissive: 4.0,                 // mesh-glow strength; the visible "light is on" cue. Was 2.2,
                                               // chosen to stay under an LDR camera's clip to white. The camera
                                               // is HDR now, so a lit tube can actually be brighter than paper
                                               // and bloom off it — that is the whole point of the change.
        field_intensity: 1.0,                  // gameplay illuminance per fixture in the LightField (0..1-ish)
        photophobic_gain: 6.0,                 // idle crabs steer down the light gradient (toward dark) at this strength; committed/roused crabs (Muster/Rally/Latch/Carry) ignore it and flood the lit room — see crab_locomotion
        photophilic_gain: 14.0,                // light-seekers steer up the gradient (toolkit; no carrier yet)
        mushroom_light_size_bonus: 0.5,        // death caps grow up to +50% bigger under a lamp (photomorphogenesis)
        mushroom_light_size_rate: 0.25,        // scale-units/sec the size bonus eases in (slow, sub-perceptual)
        flicker_hum_depth: 0.06,               // cosmetic fluorescent shimmer depth (fraction)
        flicker_fail_ratio: 0.12,              // per-tube odds of being a failing/strobing Backrooms fluorescent
                                               // (~1 in 8) — but see the cap below, which overrides this in any
                                               // room with more than ~8 emitters
        flicker_max_failing_per_room: 1,       // hard cap: at most this many tubes strobe at once per room, however
                                               // many roll under flicker_fail_ratio. Binds in dense rooms, so it —
                                               // not the ratio — sets the realized rate there. docs/artist_guide.md
                                               // documents the pair together; keep them in step.
        // The Researcher's flashlight — a moving directional emitter in the LightField (repels photophobes)
        flashlight_intensity: 3.0,             // gameplay peak illuminance at the beam origin (>fixtures, so it drives crabs off)
        flashlight_range: 8.0,                 // beam reach in dungeon cells (wall-occluded like a fixture)
        flashlight_cone_cos: 0.82,             // cos(~35deg) half-angle — a tight torch wedge
        flashlight_edge_softness: 0.15,        // soft rim: cone fades 0->1 over this cosine width
        flashlight_spot_intensity: 200000.0,   // cosmetic real SpotLight lumens (windowed-only glow)
        flashlight_spot_range: 12.0,           // cosmetic beam reach (metres)
        flashlight_spot_color: (1.0, 0.95, 0.8), // warm torch beam
        flashlight_spot_outer_angle: 0.6,      // cosmetic beam half-angle (radians, ~34deg)
        // --- Image-based ambient + HDR display. The env map REPLACED the flat ambient fill (it is not a
        // second path beside it): a uniform GlobalAmbientLight ignores surface normals by construction, so
        // it could never shade anything. Ramamoorthi & Hanrahan 2001 is why 64px suffices — see light.rs.
        env_brightness: 300.0,                 // cd/m^2 of the generated environment map. This is FILL, not key:
                                               // at 900 it out-shone the directional and washed the operatives'
                                               // pale gear to near-white.
        // Near-NEUTRAL on purpose. The first pass used the old warm ambient_color (1.0, 0.98, 0.9) here, and the
        // scene came back olive: backrooms-wall-diffuse is itself srgb(0.59,0.58,0.36) and the carpet
        // (0.54,0.48,0.22), so warm light MULTIPLIES an already-yellow material and the result saturates —
        // exactly what docs/ui.md 1.3 and the colour-language doc forbid ("saturation is reserved for
        // anomalies"). Light carries no hue of its own here; the material's warmth is the only warmth.
        // The faint warm-above / cool-below split is not decoration: it makes an upward-facing surface differ
        // in HUE as well as value from a downward one, which is extra shading signal at zero added chroma.
        env_sky_color: (0.90, 0.90, 0.88),     // +Y: fluorescent ceiling, a whisper warm
        env_ground_color: (0.13, 0.14, 0.16),  // -Y: dark, faintly cool bounce off carpet/concrete. The GAP
                                               // between the two ends is what shades a normal — flatten it and
                                               // the clay look comes straight back.
        bloom_intensity: 0.18,                 // HDR bloom; the emissive layer is now free to exceed 1.0
        shadow_max_distance: 45.0,             // metres — interior scale, not Bevy's outdoor default
        shadow_first_cascade: 12.0,            // metres — ~one large room gets the sharpest cascade
    ),
    // Almond Water (src/almond_water/) — a finite, self-regenerating heal resource that seeps from the
    // concrete and pools on the floor. Gameplay knobs drive the CPU field + consuming heal (harness-visible,
    // pinned); the trailing visual knobs are read only by the windowed iridescent-puddle plugin. Tuned
    // high-volume so pools rarely run dry under normal play, leaving a wounded-swarm drain as the exception.
    almond_water: (
        strong_seep: 8.0,          // seep/sec at a spring (sparse wall-adjacent/mold cell) — only springs seep
        pool_spacing: 12.0,        // min tiles between springs — caps each pool to a small, isolated puddle,
                                   // and (higher = rarer) how sparse the pools are across the map
        capacity: 100.0,           // per-cell volume ceiling — a rich seep pools but never runs away
        evaporate: 0.05,           // fraction dried per sec; steady state ≈ seep/evaporate (weak≈40, wall→cap)
        diffuse: 0.02,             // blend toward 4-neighbour avg per tick — kept low so a pool stays a tight
                                   // puddle (decay length √(15·diffuse/evaporate) cells) instead of a wide sheet
        heal_rate: 5.0,            // HP/sec restored to a biological standing in water (rate-limited like the medic)
        heal_per_unit_water: 1.5,  // water drunk per HP healed — the consumable coupling (drains the cell)
        forage_gain: 10.0,         // steering gain a WOUNDED creature feels climbing the water gradient
        forage_wounded_frac: 0.6,  // forage only at/below 60% health; a healthy creature ignores the water
        // --- Belief / inversion (gameplay; the water does what the population believes) ---
        belief_prior: 1.0,         // heal-reading baseline for non-cyanide pools: 0 = cyanide/poison, 1 = heal
        belief_relax: 0.05,        // rate/sec belief relaxes back toward each pool's seeded base (rumors fade)
        belief_diffuse: 0.02,      // blend toward 4-neighbour belief avg per tick — rumor spreads between pools
        belief_poison_frac: 0.15,  // fraction of floor cells seeded as cyanide (base belief 0) at the bake
        belief_flip_hi: 0.6,       // belief >= this HEALS; the band (lo,hi) is an inert deadband (no oscillation)
        belief_flip_lo: 0.4,       // belief <= this POISONS (pre-drift cyanide reading)
        poison_rate: 5.0,          // HP/sec lost drinking a fully-cyanide pool — the signed twin of heal_rate
        rumor_gain: 0.5,           // belief nudge/sec a SAFE drink deposits toward the heal reading
        death_rumor_gain: 1.0,     // belief nudge/sec a POISONING deposits toward the cyanide reading
        // --- Visual (windowed-only; ignored by the gameplay field) ---
        // Tints shifted COOL + saturated so the pool contrasts the warm olive/tan carpet — colour is the top
        // pop-out feature (Itti-Koch 1998 / Feature-Integration-Theory). Heal = cyan-teal, cyanide = toxic green.
        almond_tint: (0.20, 0.80, 0.85),  // heal pool: cool cyan-teal (linear RGB) — high contrast vs the floor
        min_visible_level: 11.0,   // draw a puddle only above this volume (visual-only). Sets how far out from
                                   // each spring reads as wet; with pool_spacing=12 + diffuse=0.02 this yields
                                   // sparse, discrete 2–5 tile puddles (see the `almond_pools_stay_small` harness test).
        film_thickness_nm: 320.0,  // thin-film thickness — sets the iridescence hue via optical path difference
        film_ior: 1.33,            // index of refraction of the water film (must be >= 1)
        iridescence_strength: 0.25,// subtle oil-slick sheen; more water = more sheen
        moisture_feed_gain: 0.3,   // how strongly water level boosts the mold's Gray-Scott bloom where they overlap
        iridescence_mute: 0.6,     // pull thin-film reflectance toward its mean (1=rainbow, 0=grey); was hardcoded
        poison_tint: (0.55, 0.95, 0.15), // cyanide pool: vivid toxic green (belief 0) — pops against warm floor
        // Readability/saliency knobs (windowed-only): opacity, glowing shoreline, wet glint, motion multiplier.
        base_alpha: 0.85,          // peak opacity of a full-depth pool (was a hardcoded 0.6 faint film)
        rim_strength: 1.6,         // brightness of the glowing shoreline waterline (figure-ground edge; 0=off)
        glint_strength: 0.6,       // wet specular glint that catches the room light and sparkles on the ripples
        ripple_strength: 1.0,      // multiplier on the animated bubble-up/ripple motion (1 = authored baseline)
        edge_feather: 0.22,        // how far fBm noise wiggles the pool boundary (breaks the tile-edge look)
        feather_scale: 0.9,        // spatial frequency of that edge noise (cycles/tile; higher = lacier margin)
    ),
    // The DETERMINISTIC CPU gameplay mold (src/mold.rs) — Fisher-KPP reaction-diffusion over the dungeon
    // grid, in the harness (optimizer-tunable), distinct from the GPU cosmetic `mycelia` above. Grows in the
    // same `mycelia.habitat` mask, spreads, and recedes from the squad's light. Couplings dim light / occlude
    // LOS / boost almond-water seep.
    mold: (
        growth: 0.08,          // logistic growth coeff per substep, toward habitat capacity
        diffuse: 0.12,         // diffusion lerp weight per substep (must be < 0.25 for a stable step)
        substeps: 4,           // reaction-diffusion substeps per FixedUpdate tick
        seed_v: 0.15,          // initial biomass seeded into each habitat cell at bake
        light_recoil: 0.05,    // recoil sink per substep per unit illuminance — the photophobia strength
        light_ref: 6.0,        // illuminance that reads as fully lit (light01 = min(1, light / light_ref))
        dim_light: 0.5,        // biomass -> LightField attenuation (mold darkens rooms; crabs less light-pushed)
        seep_boost: 1.5,       // dense biomass -> almond-water seep multiplier (live; mirrors old mold_seep_mult)
        dense_v: 0.5,          // biomass at/above which a cell counts as "dense" mold (LOS + seep)
    ),
    // Acoustic-stimulus + audio tuning (src/audio_tuning.rs). Makes sound a perception stimulus:
    // gameplay sounds deposit into the acoustic stigmergy channels (ai::field::NOISE_*) and agents
    // react to them. `stimulus` = channel propagation (evaporate/diffuse/deposit_radius, same model as
    // ai_tuning.fields) + per-event loudness (deposit amount). `perception` = per-faction reaction gains.
    // The cosmetic waveform mix stays in code (src/audio.rs) and is NOT tuned here.
    audio: (
        stimulus: (
            noise_squad: (evaporate: 2.492324, diffuse: 0.20195086, deposit_radius: 8.0),
            noise_swarm: (evaporate: 0.09777509, diffuse: 0.15594381, deposit_radius: 7.540029),
            fire_loudness: 0.0,
            impact_wall_loudness: 0.2898777,
            impact_flesh_loudness: 0.15307344,
            enemy_death_loudness: 0.9537805,
            unit_death_loudness: 0.7733592,
            // Continuous, not per-event: an SCP-610 bloom seethes for as long as it is alive. A
            // FIXED FRACTION of this is also spent on THREAT_ANOMALY at the bloom's own position
            // (`scp610::DREAD_PER_DIN`), which its containment rule caps at 0.35 — so the gene's
            // ceiling in `audio_genome::BOUNDS` is what stops the search evolving an uncontainable
            // bloom. See that table.
            flesh_drone_loudness: 0.35,
        ),
        perception: (
            // Sound-as-perception ON (FIX 2): din-response gains ship positive so a firefight shapes the
            // battlefield. crab_draw_to_din > crab_fear_of_din ⇒ the swarm converges on gunfire. Must stay
            // byte-identical to AudioTuning::default() (audio_default_equals_shipped_config guards it).
            crab_fear_of_din: 0.35405704,
            unit_fear_of_din: 0.3944512,
            crab_draw_to_din: 0.20777673,
            investigate_threshold: 0.22598898,
        ),
    ),

    // =============================================================================================
    // containment — what it takes to CAPTURE each anomaly (see `ContainmentConfig` in
    // src/containment/mod.rs). Every condition must hold simultaneously, for `hold_secs` of simulated
    // time, sampled at the anomaly's own cell against the live stigmergy field.
    //
    // NOT evolvable, like `session:` — a containment rule defines what capturing that anomaly *means*,
    // so a search free to retune it would be moving the objective rather than solving it.
    //
    // `sign` is the polarity: AtLeast = drive the channel UP, AtMost = starve it. The same channel read
    // with opposite signs is how two anomalies get opposite containment procedures (see ATTENTION in
    // src/ai/field.rs).
    // =============================================================================================
    containment: (
        // FVS-O-2's benefit half, SHIPPED OFF. `true` makes the containment HUD refuse to show an
        // anomaly's rule clauses until some operative holds a `Containable` belief about it —
        // which is the design doc's claim ("knowledge is the only thing that makes containment
        // legible") taken literally. It is off because turning it on makes the FIRST encounter
        // with every anomaly blind, which is a real pacing decision. Research grants the belief
        // (`brief_the_squad_on_completed_research`), so the loop is closed either way.
        // **TURNED ON 2026-07-27 (Director).** The containment HUD refuses to show an anomaly's rule
        // clauses until some operative holds a `Containable` belief about it — the design doc's claim
        // ("knowledge is the only thing that makes containment legible") taken literally.
        //
        // The consequence, accepted deliberately: the FIRST encounter with every anomaly is blind. That
        // is the intended shape of the loop — you meet a thing, you contain it the hard way or you do
        // not, you research it, and *then* the procedure is legible for every later encounter. Research
        // grants the belief (`brief_the_squad_on_completed_research`), so the loop closes.
        require_knowledge_for_rules: true,

        // SCP-999 — the TUTORIAL capture, and deliberately the gentlest verb in the game: you contain
        // the comfort blob by *befriending* it, not by trapping it. Holster (let THREAT_GUN decay at its
        // cell) and stay with it (keep ATTENTION on it). Both clauses are things the player does by
        // choosing NOT to fight, which is the whole pivot stated in one creature.
        //
        // Thresholds are deliberately forgiving — this is the first capture anyone performs.
        scp999: (
            requires: [
                (channel: 1, sign: AtMost,  threshold: 0.05),  // THREAT_GUN — stop shooting near it
                (channel: 9, sign: AtLeast, threshold: 0.25),  // ATTENTION  — keep eyes on it
            ],
            hold_secs: 4.0,
            break_on_fail: Keep,   // cumulative: a nervous trigger finger costs progress, not the run
        ),

        // SCP-1048 — the OUT-WATCH capture (FVS-C-3), and the exact inverse of 999's.
        //
        // The bear builds hostile copies of itself out of scavenged material, and canon is explicit
        // that it does so UNOBSERVED. So containing it is refusing to look away: hold the ambient
        // ATTENTION field over its cell and it can neither build nor slip the net.
        //
        // Note this is the AMBIENT decaying/diffusing scalar, not a per-entity watch boolean — that
        // distinction is the whole of C-3, and `enemy::ObservedBySquad` (the per-entity primitive
        // FVS-M-1 added for 173/096) is deliberately NOT what this reads. An ambient field means
        // observation is a place you maintain, not a flag you set.
        //
        // Harder than 999 on both axes, because it is the second capture anyone performs: a higher
        // ATTENTION bar (0.45 vs 0.25), twice the hold, and `Reset` rather than `Keep` — look away and
        // you start over. That is the mechanic stating itself.
        scp1048: (
            requires: [
                (channel: 9, sign: AtLeast, threshold: 0.45),  // ATTENTION — do not look away
            ],
            hold_secs: 8.0,
            break_on_fail: Reset,
        ),

        // The watch feed — the OUT-WATCH capture INVERTED (FVS-C-7).
        //
        // SCP-1048 above is contained by refusing to look away. This is the same channel with the
        // sign flipped: the feed works for an audience, so containing it means starving it of one.
        // No new primitive was needed for either — that is the point of doing this before FVS-C-6's
        // per-entity watch state, and it is why this rule is one line.
        //
        // The ceiling (0.12) sits BELOW `sim.broadcast.watch_threshold` (0.30), and the gap is the
        // design: merely making it go quiet is not yet containing it. The squad has to pull attention
        // properly off the room and hold it off, which fights their own auto-engage instinct.
        //
        // `Reset` rather than `Keep`, matching 1048: this is an attention discipline, and a discipline
        // that forgives lapses is not one. Longer hold than 999 (6 s), shorter than 1048 (8 s) — it is
        // the third capture, and the hard part is the fighting-your-instincts, not the duration.
        broadcast: (
            requires: [
                (channel: 9, sign: AtMost, threshold: 0.003), // ATTENTION — stop looking at it.
                                    // Half the watch threshold, on the same measured scale: the band
                                    // between them (0.003..0.006) is where the feed is quiet but not
                                    // yet contained, so "look away" must be held rather than satisfied
                                    // in passing. Both moved together when the scale was measured —
                                    // the old 0.12 was unreachable-by-construction in the other
                                    // direction, i.e. the feed was ALWAYS contained.
            ],
            hold_secs: 6.0,
            break_on_fail: Reset,
        ),

        // SCP-150 — the CURE capture (FVS-C-4), and the one that is not about pressure at all.
        //
        // The tongue-eating louse is contained by treating the person it is inside, not by driving it
        // into a basin: `parasite::cure_infested_hosts` extracts it directly. So this rule is carried
        // for the SPECIMEN rather than consulted as a gate — the research layer needs a rule to read,
        // and `unmet()` needs something to render if the HUD ever surfaces one.
        //
        // Authored as "keep the host calm" because that is what the fiction says treatment needs, and
        // because a rule that can never be satisfied would be a lie in the records.
        scp150: (
            requires: [
                (channel: 1, sign: AtMost, threshold: 0.10),  // THREAT_GUN — you cannot operate under fire
            ],
            hold_secs: 3.0,
            break_on_fail: Keep,
        ),

        // SCP-610, the flesh that hates. The FIRST user of the quarantine archetype: `tick_quarantine`
        // opens and closes the attempt on geometry (is the bloom inside a Quarantine), and this rule is
        // what it is held to while that is open. So the field conditions are about holding the cordon,
        // not about coaxing the anomaly — 610 cannot be persuaded, only walled off.
        //
        // AtMost THREAT_ANOMALY: the bloom must be settled, not agitated — you seal a quiet site.
        // AtMost NOISE_SQUAD: a cordon is a quiet, disciplined operation; a firefight inside it is not
        // containment. Together they say "stop fighting and hold the line", which is the same
        // stop-shooting-and-commit shape SCP-999 uses, stated on an area instead of a body.
        //
        // Reset, not Keep: a breached cordon is not partial progress. `tick_quarantine` already cancels
        // outright when the bloom leaves the region; this makes an in-cordon failure equally decisive.
        // Long hold — 12 s is the longest in the game, because area denial is the expensive verb.
        scp610: (
            requires: [
                (channel: 6, sign: AtMost, threshold: 0.35),  // THREAT_ANOMALY — the site must be settled
                (channel: 7, sign: AtMost, threshold: 0.20),  // NOISE_SQUAD    — hold the cordon quietly
            ],
            hold_secs: 12.0,
            break_on_fail: Reset,
        ),
    ),

    // =============================================================================================
    // session — how a run ends (see `SessionConfig` in src/session/mod.rs).
    //
    // NOT evolvable: this slice is deliberately absent from `WorldConfig`, so the offline search
    // cannot touch it. The win condition defines what winning MEANS, and a search allowed to shorten
    // the timer would "solve" every level by making it shorter — the knob that sets the objective
    // cannot itself be an objective. Every other tunable in this file is fair game; this one is the
    // reasoned exception to the "every feature must evolve" rule.
    //
    // `ExtractContained` is the REAL win and replaces the `SurviveTicks(18000)` placeholder that
    // shipped until now: contain `count` anomalies, then walk the surviving squad back to the cell it
    // inserted at. Both halves are required — a capture you cannot walk out with is not a secure, and
    // that walk back through a level you have already stirred up is where the tension lives.
    //
    // `count: 1` because SCP-999 is the only capturable anomaly wired today (FVS-C-2) and it is
    // deliberately the tutorial: you contain the comfort blob by befriending it. Raise this as the
    // roster grows.
    //
    // `SurviveTicks` is kept as a variant (not deleted) because the harness still drives it directly
    // to exercise the resolve -> screens -> teardown spine without needing a capture. It counts FIXED
    // ticks at the pinned 60 Hz, so it is identical at any frame rate and any headless `speed`.
    // =============================================================================================
    session: (
        win: ExtractContained(count: 1),
    ),

    // =============================================================================================
    // research — the THAUMIEL CURRICULUM (FVS-E-5 / F-1's graph / F-3's mapping).
    //
    // What a captured specimen can be asked, what completing it is worth, and what must be understood
    // first. See `src/research/curriculum.rs` for the model and its grounding.
    //
    // NOT evolvable, like `containment:` and `session:`. These define what research is WORTH; a search
    // free to retune the payouts would be moving the objective rather than solving it.
    //
    // The order of `subjects` is load-bearing: it is the tiebreak for the derived progression, so
    // reordering this list reorders the curriculum the player is shown.
    //
    // THE SHAPE, AND WHY IT IS AUTHORED BACKWARDS. Wang et al. 2019 ("Goal-based Progression Synthesis",
    // FDG '19, 10.1145/3337722.3337745) found that a good progression is GOAL-DRIVEN rather than merely
    // gradual — engagement comes from reaching a hard thing, which is why games have boss levels — and
    // that a post-order DFS over a "harder than" graph yields an order that is topologically sound AND
    // front-loads the small wins. So this is authored as a chain toward SCP-150, and the presentation
    // order is DERIVED (`Curriculum::progression`), never hand-sequenced.
    //
    // `requires` gates STUDYING a specimen, not capturing it. You may bank an anomaly you cannot yet
    // make sense of; the readout then names the prior research it is waiting on. Gating the payout
    // instead would dead-end a player who researched out of order — the work spent, the capability gone.
    //
    // `RemoteCapping`'s parent was FVS-F-3's one open content gap, CLOSED below on SCP-1048: capping a
    // nest deliberately yields NO specimen (FVS-B-7 — rewarding source-elimination would undo the
    // win-by-containing pivot), so no crab specimen exists to derive a sealing charge from, and the
    // capability read as unearnable in the tech-tree HUD. The bear teaches it instead; the reasoning is
    // at its `unlocks` entry. Do not re-open this note — the graph has no dead nodes, and
    // `a_prerequisite_nothing_grants_is_rejected` is what keeps it that way.
    // =============================================================================================
    research: (
        subjects: [
            // ── 1. SCP-999, the comfort blob — THE ENTRY POINT ────────────────────────────────────
            // No prerequisites: it is the tutorial capture, so it must be studiable from a cold start
            // or the campaign can never begin (pinned by `an_entry_point_is_available_from_a_cold_start`).
            // Its reliabilities are the highest in the file for the same reason its containment
            // thresholds are the most forgiving — the first research anyone performs should resolve
            // visibly rather than teach them that research is slow.
            (
                subject: ComfortBlob,
                // Every answer is justified by a SHIPPED mechanic, not invented: 999 has no attack path
                // in `src/scp999/`, makes no copies of itself, and its authored rule's positive clause
                // is ATTENTION AtLeast — a channel you MAINTAIN. It is harmless in every direction,
                // which is exactly right for the tutorial: the first thing you research turns out to be
                // safe, and the second one does not.
                truth: (lethality: false, contagion: false, capture_basin: true, proliferation: false),
                unlocks: [MoraleField],
                requires: [],
                experiments: [
                    (name: "AFFECT ASSAY",            param: Lethality,     reliability: 0.89),
                    (name: "CONTACT TRIAL",           param: Contagion,     reliability: 0.88),
                    (name: "ATTENTION BASIN MAPPING", param: CaptureBasin,  reliability: 0.87),
                    (name: "VOLUME SURVEY",           param: Proliferation, reliability: 0.86),
                ],
            ),

            // ── 2. SCP-1048, the builder bear ─────────────────────────────────────────────────────
            // Gated on the 999-derived morale field: out-watching the bear means standing still and
            // looking at it while its copies are abroad, which is not a thing you send operatives to do
            // until you can calm what comes at them. Harder than 999 in containment (0.45 vs 0.25, twice
            // the hold, OnBreak::Reset) and harder here too — lower reliabilities mean more repeats, and
            // E-3's fatigue makes each repeat weaker.
            (
                subject: BuilderBear,
                // The BENIGN original: it never attacks, so `lethality: false` — and that is the
                // finding that matters, because the copies it builds are the lethal ones and an
                // operative who conflates them is the FVS-O-5 misinformation case waiting to happen.
                // `contagion` and `proliferation` are both true and both earned: `scp1048_scavenge`
                // builds 1048-A copies from scavenged material if it is left unwatched.
                // `capture_basin: true` — ATTENTION AtLeast 0.45, a channel you maintain.
                truth: (lethality: false, contagion: true, capture_basin: true, proliferation: true),
                // TWO capabilities, and this is where `RemoteCapping` finally gets a parent.
                // FVS-B-7 makes capping a nest yield NO specimen on purpose, so there is no crab
                // specimen to derive a sealing charge from — and a capability nothing can grant
                // reads as broken in the tech-tree HUD. Studying how the bear SOURCES and
                // ASSEMBLES material is how you learn to seal a structure, so the bear teaches
                // both. Better than inventing a crab capture (which would change every offline
                // rollout) and better than leaving a dead node in the graph.
                unlocks: [RemoteObserver, RemoteCapping],
                requires: [MoraleField],
                experiments: [
                    (name: "ANIMATION THRESHOLD TEST", param: Lethality,     reliability: 0.86),
                    (name: "MATERIAL SOURCING AUDIT",  param: Proliferation, reliability: 0.85),
                    (name: "OBSERVER GAZE TRIAL",      param: CaptureBasin,  reliability: 0.84),
                    (name: "COPY LINEAGE SCREEN",      param: Contagion,     reliability: 0.83),
                ],
            ),

            // ── 3. SCP-150, the parasite — THE GOAL ───────────────────────────────────────────────
            // The sink of the graph, so `Curriculum::goals` names it and the progression builds toward
            // it. Gated on the 1048-derived remote observer, which is the Thaumiel step that makes the
            // cure practical: the observer holds ATTENTION on the host's cell without an operative
            // standing there, which is what frees a pair of hands to actually administer treatment.
            // The lowest reliabilities in the file — this is the boss, and it should feel like one.
            (
                subject: Parasite,
                // The only lethal one on the roster: `gestation_tick` kills its host outright if the
                // burst is not interrupted. `contagion` and `proliferation` both true — a burst seeds
                // new manca, which embed in new hosts. `capture_basin: FALSE`, and it is the one
                // false here: SCP-150 is not driven into a field basin at all, it is extracted BY HAND
                // (`cure_infested_hosts`). Resolving that parameter is the moment the player learns
                // this anomaly does not play by the rule the other two taught them.
                truth: (lethality: true, contagion: true, capture_basin: false, proliferation: true),
                unlocks: [FieldCure],
                requires: [RemoteObserver],
                experiments: [
                    (name: "HOST NECROSIS PANEL",     param: Lethality,     reliability: 0.85),
                    (name: "VECTOR TRANSMISSION RUN", param: Contagion,     reliability: 0.84),
                    (name: "EXCISION REHEARSAL",      param: CaptureBasin,  reliability: 0.82),
                    (name: "BROOD COUNT",             param: Proliferation, reliability: 0.82),
                ],
            ),
        ],
    ),
)
